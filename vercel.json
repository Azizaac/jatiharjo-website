{
  "version": 2,
  "crons": [
    {
      "path": "/api/keep-alive.php",
      "schedule": "0 0 */3 * *"
    }
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "api/keep-alive.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/data\\.json",
      "status": 403
    },
    {
      "src": "/assets/images/uploads/(.*)\\.php$",
      "status": 403
    },
    {
      "src": "/(.*\\.php)$",
      "dest": "/api/index.php"
    },
    {
      "src": "/admin/?",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
